# Primary Server Configuration
PORT=5000
NODE_ENV=development

# Primary PostgreSQL Database (Handles Writes & Fallback Reads)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arrow_puzzle

# Scaled Read Replica PostgreSQL (Handles High-Concurrency Reads)
# Optional: defaults to DATABASE_URL if omitted
READ_REPLICA_URL=postgresql://postgres:postgres@localhost:5433/arrow_puzzle

# Redis Distributed Cache
# Optional: automatically falls back to in-memory TTL cache if not running
REDIS_URL=redis://localhost:6379

# Multi-Core Horizontal Clustering
# Optional: number of worker instances to spawn in cluster mode
WORKERS=4
